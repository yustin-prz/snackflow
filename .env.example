# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el .env real al repo (ya está en .gitignore).

# Postgres local (el que levanta docker-compose, contenedor "db")
DATABASE_URL=postgresql://snackflow_user:PASSWORD@db:5432/snackflow
DB_PASSWORD=PASSWORD

# Neon PostgreSQL (nube) — el backend intenta conectar acá primero y usa el
# local como respaldo si no hay internet. Dejalo vacío si no vas a usar Neon.
DATABASE_BACKUP_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

PORT=3000
NODE_ENV=development

# String larga y aleatoria (32+ caracteres) — se usa para firmar los JWT.
JWT_SECRET=clave_larga_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# Cuenta de Gmail con "contraseña de aplicación" (no la contraseña normal)
# para el envío de correos (contraseñas temporales, facturas electrónicas).
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
MAIL_FROM=SnackFlow POS <tu_correo@gmail.com>
